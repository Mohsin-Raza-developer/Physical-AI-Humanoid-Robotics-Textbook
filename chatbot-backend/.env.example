# Authentication
JWT_SECRET=your_jwt_secret_from_auth_backend

# Application
FRONTEND_URL=https://mohsin-raza-developer.github.io
LOG_LEVEL=INFO
ENVIRONMENT=development

# Monitoring (optional)
SENTRY_DSN=your_sentry_dsn_here
