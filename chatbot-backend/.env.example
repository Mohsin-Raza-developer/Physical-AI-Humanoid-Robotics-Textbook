# Database
DATABASE_URL=postgresql+asyncpg://user:password@neon-host/dbname

# AI Services
GEMINI_API_KEY=your_gemini_api_key_here
COHERE_API_KEY=your_cohere_api_key_here

# Vector Database
QDRANT_URL=https://your-cluster.qdrant.io
